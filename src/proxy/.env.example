PORT=3000
LOG_LEVEL=info
DB_PATH=./data/proxy.sqlite
API_KEY=change-me
IDENTITY_HEADER=X-User-Identity
IDENTITY_HEADER_REQUIRED=true
## CLAUDE_CODE_OPTIMIZED default to false in code. 
CLAUDE_CODE_OPTIMIZED=true
INTERNAL_API_TOKEN=change-me
SSO_BASE_URL=http://localhost:7001
LOGIN_BASE_URL=http://localhost:7003
ENTERPRISE_SHORTCODE=octo
REQUEST_STATS_PER_ACCOUNT_LIMIT=100

EDITOR_VERSION=vscode/1.124.2
EDITOR_PLUGIN_VERSION=copilot-chat/0.52.0
USER_AGENT=GitHubCopilotChat/0.52.0
GITHUB_API_VERSION=2026-01-09
COPILOT_INTEGRATION_ID=vscode-chat

# VS Code-style Copilot headers used only when CLAUDE_CODE_OPTIMIZED=true.
# Leave blank to generate per-process IDs.
# VSCODE_SESSION_ID=
# VSCODE_MACHINE_ID=
# EDITOR_DEVICE_ID=
# CLAUDE_CODE_GITHUB_API_VERSION=2026-01-09
# CLAUDE_CODE_COPILOT_INTEGRATION_ID=vscode-chat
# CLAUDE_CODE_EDITOR_VERSION=vscode/1.95.0
# CLAUDE_CODE_EDITOR_PLUGIN_VERSION=copilot-chat/0.46.0
# CLAUDE_CODE_USER_AGENT=GitHubCopilotChat/0.46.0
