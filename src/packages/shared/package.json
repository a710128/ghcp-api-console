{
  "name": "@ghcp/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "pretest": "npm --workspace @ghcp/shared run build && npm --workspace @ghcp/database run build",
    "test": "node --test --import tsx/esm \"src/**/*.unit.test.ts\""
  }
}
