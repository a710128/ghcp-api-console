# Copy this file to .env before running docker compose.
# Replace every change-me value before deploying outside local development.
# WARNING: Never commit .env with real secrets to source control.

LOG_LEVEL=info

# ============================================================
# PostgreSQL database credentials
# ============================================================
POSTGRES_DB=ghcp
POSTGRES_USER=ghcp
POSTGRES_PASSWORD=change-me-postgres-password

# Application name prefix for pg_stat_activity
DB_APPLICATION_NAME=ghcp

# Encryption keys: exactly 32 bytes, base64-encoded
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMMUTABLE: changing these keys requires reprovisioning the database from empty state.
DATA_ENCRYPTION_KEY=change-me-32-byte-base64-encoded-key-1
LOGIN_JOB_ENCRYPTION_KEY=change-me-32-byte-base64-encoded-key-2

# ============================================================
# Service routing hostnames (used by Traefik)
# ============================================================
PROXY_HOST=proxy.example.com
SSO_HOST=sso.example.com
CONSOLE_HOST=console.example.com

# ============================================================
# Shared internal/API secrets
# ============================================================
API_KEY=change-me-proxy-api-key
INTERNAL_API_TOKEN=change-me-internal-token
SESSION_SECRET=change-me-session-secret

# ============================================================
# Proxy public API and outbound Copilot headers
# ============================================================
IDENTITY_HEADER=X-User-Identity
IDENTITY_HEADER_REQUIRED=true
CLAUDE_CODE_OPTIMIZED=true

EDITOR_VERSION=vscode/1.124.2
EDITOR_PLUGIN_VERSION=copilot-chat/0.52.0
USER_AGENT=GitHubCopilotChat/0.52.0
GITHUB_API_VERSION=2025-04-01
COPILOT_INTEGRATION_ID=vscode-chat

# Leave blank to generate per-process IDs.
VSCODE_SESSION_ID=
VSCODE_MACHINE_ID=
EDITOR_DEVICE_ID=
CLAUDE_CODE_GITHUB_API_VERSION=2026-01-09

# ============================================================
# SSO/SAML settings
# ============================================================
# SSO_CERT_DIR must contain idp-cert.pem and idp-key.pem
SSO_CERT_DIR=./certs
SP_ENTITY_ID=https://github.com/enterprises/acme
SP_ACS_URL=https://github.com/enterprises/acme/saml/consume
SSO_EMAIL_DOMAIN=customsso.com
USER_PREFIX=user

# ============================================================
# GitHub Enterprise / SCIM / Copilot settings
# ============================================================
ENTERPRISE_SLUG=acme
ENTERPRISE_SHORTCODE=octo
GITHUB_API_BASE_URL=https://api.github.com
SCIM_BASE_URL=https://api.github.com/scim/v2/enterprises/acme
SCIM_TOKEN=change-me-scim-token
SCIM_REQUEST_DELAY_MS=250
SCIM_MAX_RETRIES=3
SCIM_RETRY_BASE_DELAY_MS=1000
GITHUB_COPILOT_SEAT_PAT=change-me-github-pat

# ============================================================
# Login worker settings
# ============================================================
LOGIN_SSO_PROVIDER=custom
AUTH_HEADLESS=true
AUTH_TIMEOUT_MS=60000

# ============================================================
# Test database (for integration tests only)
# ============================================================
TEST_DATABASE_URL=postgres://ghcp_test:ghcp_test_password@localhost:5433/ghcp_test
